# Problem 3:
# Given two lists, find the common elements.
#
# Example:
# list1 = [1, 2, 3, 4, 5]
# list2 = [3, 4, 5, 6, 7]
#
# Expected Output:
# [3, 4, 5]

list1 = [1, 2, 3, 4, 5]
list2 = [3, 4, 5, 6, 7]

common = []

for num in list1:
    if num in list2:
        common.append(num)

print("Problem 3:", common)